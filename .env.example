# ─────────────────────────────────────────────────────────
#  Nexora Pips Telegram CRM — Configuration
#  Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────

# ── Telegram API credentials ──────────────────────────────
# Get these from: https://my.telegram.org → API Development Tools
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# Session file name (Telethon adds .session automatically)
SESSION_NAME=nexora_session

# ── Flask ─────────────────────────────────────────────────
# Change this to a long random string — keeps sessions secure
SECRET_KEY=change-this-to-a-long-random-secret-key-abc123

# ── Broadcast settings ────────────────────────────────────
# Delay between messages in seconds (keep ≥ 3 to avoid bans)
BROADCAST_DELAY=4

# Max image upload size in MB
MAX_IMAGE_MB=10
